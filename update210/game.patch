+/* Underwater approach follows the actual hooked fish and bait. */
+(function (FZ) {
+  "use strict";
+  const G = FZ.Game, clamp = FZ.U.clamp;
+  const bed = new Image(); bed.src = "assets/scenes/below.webp";
+  const cv = document.getElementById("cv"), ctx = cv.getContext("2d");
+  let dissolve = 0;
+  function twitch(r) {
+    const h = r.hunt;
+    if (!h || r.state !== "wait") return;
+    const gap = h.age - h.last;
+    if (gap < 0.24) return;
+    h.last = h.age; h.pulse = 1;
+    if (gap < 1.05) { h.shy = 1.55; h.interest = Math.max(0.03,h.interest - 0.19); }
+    else if (!h.shy) h.interest = Math.min(1,h.interest + 0.22);
+  }
+  function render(r,s,t,dt) {
+    const h = r && r.hunt;
+    if (!h || !['settle','wait','bite','fight'].includes(r.state) ||
+        (r.state === 'fight' && (r.fish.t > 3.4 || r.fish.jump))) { dissolve = 0; return false; }
+    const {W,H} = FZ.Scene.size(), scale = cv.width/W;
+    if (!bed.naturalWidth) return false;
+    const fight = r.state === 'fight' ? r.fish : null;
+    const bite = r.state === 'bite' ? r.bite : null;
+    const take = bite && bite.phase === 'take';
+    ctx.save(); ctx.setTransform(scale,0,0,scale,0,0);
+    const mag = Math.max(W/bed.width,H/bed.height)*1.075;
+    const bw=bed.width*mag, bh=bed.height*mag;
+    ctx.drawImage(bed,(W-bw)*0.5+Math.sin(t*.24)*W*.014,(H-bh)*.5+Math.cos(t*.29)*H*.009,bw,bh);
+    const dark=s.period==='night'?.43:s.period==='dusk'?.22:.06;
+    ctx.fillStyle='rgba(4,28,37,'+dark+')';ctx.fillRect(0,0,W,H);
+    const reach=clamp(h.interest,0,1);
+    const mx=W*(.58+Math.sin(t*1.2)*.012);
+    const my=H*(.54+.009*Math.sin(t*1.5)-.085*h.pulse);
+    const fishSize=Math.min(W*.61,H*.58)*(.57+reach*.43);
+    const retreat=h.shy*.12;
+    const gap=(1-reach)*W*.37+retreat*W+(bite&&!take?10+Math.sin(t*6)*7:0);
+    let fx=mx-fishSize*.42-gap,fy=my+Math.sin(t*2.3)*3+gap*.16;
+    if(fight){fx+=Math.sin(fight.t*4)*W*.13;fy+=Math.sin(fight.t*5)*H*.05;}
+    const ax=fight?fx+fishSize*.42:mx,ay=fight?fy:my;
+    ctx.lineWidth=1.15;ctx.strokeStyle='rgba(225,245,230,.71)';ctx.beginPath();ctx.moveTo(W*.69,-5);
+    ctx.quadraticCurveTo(W*.59+Math.sin(t)*8,H*.25,ax,ay);ctx.stroke();
+    const bait=G.gear(s.mode).bait,im=bait&&FZ.Assets.item(bait.id);
+    if(im){const size=Math.min(W,H)*.075;ctx.drawImage(im,ax-size*.48,ay-size*.33,size,size);}
+    FZ.Art.drawFish(ctx,h.fish,fx,fy,fishSize,{dir:-1,phase:t*(fight?14:5),amp:fight?.38:.17,roll:Math.sin(t*1.8)*.028});
+    ctx.fillStyle='rgba(217,242,214,.55)';
+    for(let i=0;i<30;i++){
+      const x=((i*.618+Math.sin(t*.31+i)*.013+t*.009)%1)*W;
+      const y=((i*.381+2-(t*.018)%1)%1)*H;
+      ctx.beginPath();ctx.arc(x,y,.55+(i%4)*.38,0,Math.PI*2);ctx.fill();
+    }
+    dissolve=Math.min(1,dissolve+dt*2.8);
+    if(dissolve<1){ctx.fillStyle='rgba(108,176,159,'+(1-dissolve)*.8+')';ctx.fillRect(0,0,W,H);}
+    ctx.restore();return true;
+  }
+  FZ.Dive={render,twitch};
+})(window.FZ);
