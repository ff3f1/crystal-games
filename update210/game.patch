diff --git a/js/rival.js b/js/rival.js
new file mode 100644
index 0000000..29cfe0a
--- /dev/null
+++ b/js/rival.js
@@ -0,0 +1,39 @@
+/* A catch carries its venue, species and weight. Challenges survive app restarts. */
+(function (FZ) {
+  "use strict";
+  const G = FZ.Game, UI = FZ.UI, U = FZ.U;
+  const key = "fz_rival_catch_v1";
+  function decode(input) {
+    const m = String(input).toLowerCase().match(/\brf1-([a-z0-9]+)-([a-z0-9]+)-(\d{1,7})\b/);
+    if (!m) return null;
+    const loc = FZ.LOC[m[1]], fish = FZ.SP[m[2]], grams = Number(m[3]);
+    if (!loc || !fish || !loc.fish[fish.id] || grams < 1 || grams > Math.ceil(fish.max * 1000)) return null;
+    return {loc, fish, grams, code: m[0].toUpperCase()};
+  }
+  function active() {
+    try { return decode(localStorage.getItem(key)); } catch (_) { return null; }
+  }
+  function code(r) { return ('RF1-' + r.loc + '-' + r.s.id + '-' + Math.round(r.w * 1000)).toUpperCase(); }
+  function score(r) {
+    const target = active();
+    if (!target || r.loc !== target.loc.id || r.s.id !== target.fish.id) return;
+    const diff = Math.round(r.w * 1000) - target.grams;
+    r.rivalText = diff > 0 ? 'Вызов выигран · +' + U.kg(diff / 1000) : diff === 0 ? 'Ничья! Ещё один заброс?' : 'До победы ещё ' + U.kg((1 - diff) / 1000);
+    if (diff > 0) localStorage.removeItem(key);
+  }
+  function open() {
+    const a = active();
+    const sheet = UI.sheet('<div class="eyebrow">РЫБАЦКОЕ ПАРИ</div><h2>Побей улов друга</h2><div class="scroll"><p>Друг присылает открытку с кодом. Поймай рыбу того же вида на том же водоёме хотя бы на грамм тяжелее.</p>' +
+      (a ? '<div class="catch-goal"><span>ТВОЯ ЦЕЛЬ · '+a.loc.n+'</span><b>'+a.fish.n+' · больше '+U.kg(a.grams/1000)+'</b></div>' : '') +
+      '<label for="rivalCode">Код с открытки или весь текст сообщения</label><input id="rivalCode" maxlength="800" placeholder="RF1-…" autocomplete="off"><button class="btn brass" id="rivalAccept">Принять вызов</button><p id="rivalStatus" aria-live="polite"></p></div>',UI.showMenu);
+    sheet.querySelector('#rivalAccept').onclick = () => {
+      const target = decode(sheet.querySelector('input').value);
+      const status = sheet.querySelector('#rivalStatus');
+      if (!target) { status.textContent = 'Проверь код. Он начинается с RF1.'; return; }
+      if (G.state().lvl < target.loc.lvl) { status.textContent = target.loc.n+' откроется на уровне '+target.loc.lvl; return; }
+      localStorage.setItem(key,target.code);
+      status.textContent = 'Вызов принят! Твоя цель — '+target.fish.n+', больше '+U.kg(target.grams/1000)+'. Водоём — '+target.loc.n+'.';
+    };
+  }
+  FZ.Rival = { code, decode, score, open, active };
+})(window.FZ);
