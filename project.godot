; Engine configuration file.
config_version=5

[application]

config/name="Костяная Жатва"
config/description="Кровавый экшен про некроманта и армию мёртвых. Crystal Games."
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="BoneHarvest"

[autoload]

G="*res://scripts/g.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true

[gui]

theme/default_theme_scale=1.0
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="debris"
3d_physics/layer_4="ragdoll"
3d_physics/layer_5="pickups"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
environment/ssao/quality=2
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=96
global_illumination/gi/use_half_resolution=true
shading/overrides/force_vertex_shading=false
limits/cluster_builder/max_clustered_elements=1024

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/confusable_local_declaration=0
