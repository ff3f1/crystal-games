+.cabin-nav button{display:flex;align-items:center;gap:6px;padding:14px 1px;font-size:13px}.cabin-nav svg,.cabin-duel svg{color:#e6cc99}
+.cabin-duel{display:flex;align-items:center;width:100%;gap:13px;text-align:left;padding:14px 0}.cabin-duel span{font-weight:700}.cabin-duel small{display:block;color:#c8d1c4;font-size:11px;margin-top:3px;font-weight:400}.cabin-duel b{margin-left:auto;font-size:27px;color:#e6cc99}
+.cabin footer{border-top:1px solid #d8e2d438;color:#d7ddd0;padding:10px 0 0;font-size:11px}.cabin footer strong{color:#efcc89}
+#cabinDrawer[hidden]{display:none}#cabinDrawer{position:absolute;z-index:3;right:0;top:0;bottom:0;overflow:auto;width:min(88%,340px);box-sizing:border-box;background:#172822;box-shadow:-30px 0 80px #081511ba;padding:calc(24px + var(--safe-t,0px)) 22px 16px}
+.cabin-drawer-head{margin-bottom:18px}.cabin-drawer-head h2{font:32px Georgia,serif;margin:0}#cabinClose{font-size:26px}
+#cabinDrawer>button{display:flex;align-items:center;gap:14px;border-bottom:1px solid #e2ddbb29;text-align:left;width:100%;min-height:45px;font-size:15px}
+@media(max-height:580px){.cabin{padding-top:12px}.cabin-deck{margin-top:20px}.cabin-brand h1{font-size:54px}.cabin-deck>h2{font-size:28px;margin-bottom:9px}.cabin-nav button,.cabin-duel{padding-top:8px;padding-bottom:8px}}
+
+.lure-readout{position:absolute;left:12px;top:calc(90px + var(--safe-t));border-left:2px solid #e7c78b;padding:6px 10px;background:#102e31bb;color:#f4e9c7;font:500 12px Rubik,sans-serif;pointer-events:none}
